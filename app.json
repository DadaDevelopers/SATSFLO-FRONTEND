{
  "expo": {
    "name": "SatsFlo",
    "slug": "satsflo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/Logo-square.png",
    "scheme": "satsflofrontend",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.anonymous.SATSFLOFRONTEND",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
      "bundleIdentifier": "com.anonymous.SATSFLOFRONTEND",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/Logo.png",
        "backgroundImage": "./assets/images/Logo.png",
        "monochromeImage": "./assets/images/Logo.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/Logo-square.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/Logo-square.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
          "backgroundColor": "#ffffff"
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-audio",
      "expo-asset",
      "expo-web-browser",
      "expo-notifications"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "53d8d698-98b5-4f29-bd65-a353d1de0e5d"
      }
    },
    "owner": "mercymbao"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "24260913-f716-4eae-9380-9cfd3bfa93f8"
      }
    },
    "owner": "mercymbao"
  }
}
